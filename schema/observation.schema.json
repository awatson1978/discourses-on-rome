{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "title": "Historical observation extracted from the Discorsi or a source text",
  "type": "object",
  "required": [
    "observation_id", "discorsi_reference", "source_passage", "source_language",
    "historical_event", "evidence_class", "confidence", "provenance"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "pattern": "^obs:[a-z0-9][a-z0-9-]+$",
      "description": "Stable id, e.g. obs:d1c7-coriolanus-grain"
    },
    "discorsi_reference": {
      "type": "string",
      "pattern": "^(disc|livy):(it|en|la):[0-9]+:[0-9]+$",
      "description": "passage_id of the segment this observation was extracted FROM (despite the field name, Livy-side extractions cite the Livy segment)"
    },
    "source_passage": {
      "type": "string",
      "minLength": 10,
      "description": "Verbatim quotation from the cited segment (validated as substring modulo whitespace)"
    },
    "source_language": { "enum": ["it", "la", "en"] },
    "historical_event": { "type": "string" },
    "estimated_date": {
      "type": ["string", "null"],
      "description": "ISO-ish historical date, e.g. '-0491' or '-0491/-0488'; null if inapplicable"
    },
    "date_uncertainty": {
      "type": "string",
      "description": "e.g. 'traditional Varronian chronology; episode semi-legendary'"
    },
    "location": { "type": "string" },
    "actors": { "type": "array", "items": { "type": "string" } },
    "institutions": { "type": "array", "items": { "type": "string" } },
    "population_groups": { "type": "array", "items": { "type": "string" } },
    "resources": { "type": "array", "items": { "type": "string" } },
    "administrative_actions": { "type": "array", "items": { "type": "string" } },
    "political_actions": { "type": "array", "items": { "type": "string" } },
    "outcomes": { "type": "array", "items": { "type": "string" } },
    "claimed_mechanism": {
      "type": "string",
      "description": "Causal mechanism asserted IN THE SOURCE for this event; empty if none"
    },
    "evidence_class": {
      "enum": ["source-reported", "machiavelli-claim", "modern-scholarship",
               "analysis-inference", "hypothetical"]
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Derivation path: passage ids, extraction method, analyst notes"
    }
  },
  "additionalProperties": false
}
