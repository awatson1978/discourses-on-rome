    </edge>
    <edge id="e33" source="ont:timing-of-reform" target="ont:popular-unrest">
      <data key="ek0">claim:d1c37-retroactive-law</data>
      <data key="ek1">machiavelli</data>
      <data key="ek2">Making a law that looks far backward against an entrenched custom is extremely scandalous; temporizing is preferable, for delayed evil arrives later or extinguishes itself.</data>
      <data key="ek3">negative</data>
      <data key="ek4">prescription</data>
      <data key="ek5">disc:it:1:37</data>
      <data key="ek6">historically situated claim, not established causal fact</data>
    </edge>
    <edge id="e34" source="ont:timing-of-reform" target="ont:institutional-survival">
      <data key="ek0">claim:d1c37-retroactive-law</data>
      <data key="ek1">machiavelli</data>
      <data key="ek2">Making a law that looks far backward against an entrenched custom is extremely scandalous; temporizing is preferable, for delayed evil arrives later or extinguishes itself.</data>
      <data key="ek3">negative</data>
      <data key="ek4">prescription</data>
      <data key="ek5">disc:it:1:37</data>
