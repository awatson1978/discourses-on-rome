      <data key="ek2">Private repression of a citizen triggers a cascade: private offense generates fear, fear seeks defense, defense recruits partisans, partisans become parties, parties ruin the city.</data>
      <data key="ek3">negative</data>
      <data key="ek4">causal-mechanism</data>
      <data key="ek5">disc:it:1:7</data>
      <data key="ek6">historically situated claim, not established causal fact</data>
    </edge>
    <edge id="e10" source="ont:ordinary-vs-extraordinary" target="ont:institutional-survival">
      <data key="ek0">claim:d1c7-faction-cascade</data>
      <data key="ek1">machiavelli</data>
      <data key="ek2">Private repression of a citizen triggers a cascade: private offense generates fear, fear seeks defense, defense recruits partisans, partisans become parties, parties ruin the city.</data>
      <data key="ek3">negative</data>
      <data key="ek4">causal-mechanism</data>
      <data key="ek5">disc:it:1:7</data>
