    </edge>
    <edge id="e31" source="ont:roba-vs-onori" target="ont:ordinary-vs-extraordinary">
      <data key="ek0">claim:d1c37-roba-vs-onori</data>
      <data key="ek1">machiavelli</data>
      <data key="ek2">Men value property more than honors: the nobility yielded honors to the plebs without extraordinary scandal, but defended property with such obstinacy that the plebs resorted to extraordinary means.</data>
      <data key="ek3">positive</data>
      <data key="ek4">empirical-generalization</data>
      <data key="ek5">disc:it:1:37</data>
      <data key="ek6">historically situated claim, not established causal fact</data>
    </edge>
    <edge id="e32" source="ont:roba-vs-onori" target="ont:popular-unrest">
      <data key="ek0">claim:d1c37-roba-vs-onori</data>
      <data key="ek1">machiavelli</data>
      <data key="ek2">Men value property more than honors: the nobility yielded honors to the plebs without extraordinary scandal, but defended property with such obstinacy that the plebs resorted to extraordinary means.</data>
      <data key="ek3">positive</data>
      <data key="ek4">empirical-generalization</data>
      <data key="ek5">disc:it:1:37</data>
