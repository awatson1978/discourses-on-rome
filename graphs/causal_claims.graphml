    <edge id="e21" source="ont:reputation-public" target="ont:tyranny-risk">
      <data key="ek0">claim:d3c28-public-vs-private-reputation</data>
      <data key="ek1">machiavelli</data>
      <data key="ek2">A well-ordered republic opens public ways to reputation (counsel and deeds for the common benefit, rewarded with honors) and closes private ways (benefits to individuals creating partisans).</data>
