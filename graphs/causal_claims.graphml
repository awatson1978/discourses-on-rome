    </edge>
    <edge id="e35" source="ont:land-distribution" target="ont:institutional-survival">
      <data key="ek0">claim:d1c37-agrarian-destroyed-republic</data>
      <data key="ek1">machiavelli</data>
      <data key="ek2">The contention over the agrarian law, reawakened by the Gracchi against adversaries whose power had doubled in the interim, destroyed Roman liberty through the Marius-Sulla and Caesar-Pompey faction wars; yet the same plebeian appetite had also checked noble ambition for three hundred years.</data>
      <data key="ek3">conditional</data>
      <data key="ek4">empirical-generalization</data>
      <data key="ek5">disc:it:1:37</data>
      <data key="ek6">historically situated claim, not established causal fact</data>
    </edge>
