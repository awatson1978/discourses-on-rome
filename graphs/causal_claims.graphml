    </edge>
    <edge id="e29" source="ont:necessity-vs-ambition" target="ont:popular-unrest">
      <data key="ek0">claim:d1c37-ambition-after-necessity</data>
      <data key="ek1">machiavelli</data>
      <data key="ek2">Men fight first from necessity, then from ambition; desire always exceeds the power of acquiring, producing permanent discontent with what is possessed.</data>
      <data key="ek3">positive</data>
      <data key="ek4">empirical-generalization</data>
      <data key="ek5">disc:it:1:37</data>
      <data key="ek6">historically situated claim, not established causal fact</data>
    </edge>
    <edge id="e30" source="ont:necessity-vs-ambition" target="ont:umori">
