      <data key="ek0">claim:d3c28-punish-early</data>
      <data key="ek1">machiavelli</data>
      <data key="ek2">Leaving one such private-reputation seeker unpunished is apt to ruin a republic, because after the precedent it is difficult to return to the true path.</data>
      <data key="ek3">negative</data>
      <data key="ek4">causal-mechanism</data>
      <data key="ek5">disc:it:3:28</data>
      <data key="ek6">historically situated claim, not established causal fact</data>
    </edge>
